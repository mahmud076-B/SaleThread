# ============================================================
# SaleThread — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salethread?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
# Must be at least 32 characters.
AUTH_SECRET="replace-me-with-a-real-random-secret-at-least-32-chars"

# Base URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Meta API Configuration (Day 3-6)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_meta_verify_token
